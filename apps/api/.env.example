DATABASE_URL="postgresql://user:password@localhost:5432/dealroom?schema=public"

PORT=3000
API_URL="http://localhost:3000"
WEB_URL="http://localhost:4200"

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Salt for hashing viewer IPs. Changing it orphans existing unique-viewer counts.
IP_HASH_SALT="replace-with-a-long-random-string"

# local writes to disk for development, s3 targets any S3-compatible bucket
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

RESEND_API_KEY=""
MAIL_FROM="Deal Room <notifications@updates.rufaiahmed.com>"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
